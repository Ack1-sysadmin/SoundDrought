<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for SoundDrought ("default" in the SoundDrought project).
  The GitHub artifact is a zip that contains the single-file exe. Only that exe is signed,
  and only if its file properties name it as SoundDrought (SignPath Foundation requirement).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="SoundDrought.exe" product-name="SoundDrought">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
