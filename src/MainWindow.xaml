<Window x:Class="SoundDrought.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoundDrought"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SoundDrought" Icon="/Assets/app.ico"
        Width="1280" Height="820" MinWidth="420" MinHeight="320"
        Background="#121212">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbPrev" Description="{x:Static local:L.Previous}" Click="ThumbPrev_Click" />
                <ThumbButtonInfo x:Name="ThumbPlay" Description="{x:Static local:L.Play}" Click="ThumbPlay_Click" />
                <ThumbButtonInfo x:Name="ThumbNext" Description="{x:Static local:L.Next}" Click="ThumbNext_Click" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <WindowChrome.WindowChrome>
        <!-- Our own title bar: the navigation bar doubles as caption. -->
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:NavBar x:Name="Nav" />
        <!-- WebView2 is a child HWND and swallows mouse input, so keep the resize border free of it. -->
        <wv2:WebView2 x:Name="Web" Grid.Row="1" Margin="5,0,5,5" DefaultBackgroundColor="#121212" />
    </Grid>
</Window>
