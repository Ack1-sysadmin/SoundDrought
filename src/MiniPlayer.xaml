<Window x:Class="SoundDrought.MiniPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini-Player" Icon="/Assets/app.ico"
        Width="380" Height="104"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="#181818" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="OnDrag">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#383838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#909090" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
        </Grid.RowDefinitions>

        <!-- Artwork -->
        <Border Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8800" Offset="0" />
                    <GradientStop Color="#FF3300" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Image x:Name="Artwork" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- Title, artist, controls -->
        <Grid Grid.Column="1" Margin="12,8,6,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TrackTitle" Text="Nichts wird abgespielt" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,-4,0,0" VerticalAlignment="Top">
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE740;" ToolTip="Großes Fenster (Strg+M)" Click="OnExpand" />
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE8BB;" ToolTip="In den Infobereich" Click="OnHide" />
            </StackPanel>

            <TextBlock x:Name="TrackArtist" Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Foreground="#A0A0A0"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />

            <Grid Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Zurück" Click="OnPrev" />
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="20" ToolTip="Abspielen" Click="OnPlay" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Weiter" Click="OnNext" />
                    <Button x:Name="LikeButton" Style="{StaticResource IconButton}" Content="&#xEB51;" ToolTip="Gefällt mir" Click="OnLike" />
                </StackPanel>
                <TextBlock x:Name="Time" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="#808080" Margin="0,0,6,0" />
            </Grid>
        </Grid>

        <!-- Progress (click to seek) -->
        <Grid x:Name="Timeline" Grid.Row="1" Grid.Column="1" Background="#2A2A2A" Cursor="Hand"
              MouseLeftButtonDown="OnSeek">
            <Rectangle Fill="#FF5500" HorizontalAlignment="Stretch">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
