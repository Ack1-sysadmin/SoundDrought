<Window x:Class="SoundDrought.MiniPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoundDrought"
        Title="Mini-Player" Icon="/Assets/app.ico"
        Width="380" Height="104"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="#181818" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="OnDrag">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#383838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#909090" />
        </Style>
        <!-- Thin volume slider: click anywhere to jump, drag the thumb (shown on hover) -->
        <Style x:Key="VolumeTrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.05" />
            <Setter Property="LargeChange" Value="0.1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource VolumeTrackPart}" Background="#E8E8E8" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource VolumeTrackPart}" Background="#3A3A3A" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Width="10" Height="10" Opacity="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
        </Grid.RowDefinitions>

        <!-- Artwork -->
        <Border Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8800" Offset="0" />
                    <GradientStop Color="#FF3300" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Image x:Name="Artwork" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- Title, artist, controls -->
        <Grid Grid.Column="1" Margin="12,8,6,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TrackTitle" Text="{x:Static local:L.NothingPlaying}" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,-4,0,0" VerticalAlignment="Top">
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE740;" ToolTip="{x:Static local:L.FullWindow}" AutomationProperties.Name="{x:Static local:L.FullWindow}" Click="OnExpand" />
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE8BB;" ToolTip="{x:Static local:L.HideToTray}" AutomationProperties.Name="{x:Static local:L.HideToTray}" Click="OnHide" />
            </StackPanel>

            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,1,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TrackArtist" FontSize="12" Foreground="#A0A0A0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Time" Grid.Column="1" FontSize="11" Foreground="#808080" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="{x:Static local:L.Previous}" AutomationProperties.Name="{x:Static local:L.Previous}" Click="OnPrev" />
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="20" ToolTip="{x:Static local:L.Play}" AutomationProperties.Name="{x:Static local:L.Play}" Click="OnPlay" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="{x:Static local:L.Next}" AutomationProperties.Name="{x:Static local:L.Next}" Click="OnNext" />
                    <Button x:Name="LikeButton" Style="{StaticResource IconButton}" Content="&#xEB51;" ToolTip="{x:Static local:L.Like}" AutomationProperties.Name="{x:Static local:L.Like}" Click="OnLike" />
                </StackPanel>
                <!-- Volume: speaker toggles mute, bar is click/drag; the wheel works anywhere on the window -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE995;" FontSize="14" Width="30"
                            ToolTip="{x:Static local:L.Mute}" AutomationProperties.Name="{x:Static local:L.Mute}" Click="OnMute" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Width="68" Margin="2,0,0,0"
                            AutomationProperties.Name="{x:Static local:L.Volume}"
                            ValueChanged="OnVolumeChanged" Thumb.DragCompleted="OnVolumeDragCompleted" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Progress (click to seek) -->
        <Grid x:Name="Timeline" Grid.Row="1" Grid.Column="1" Background="#2A2A2A" Cursor="Hand"
              MouseLeftButtonDown="OnSeek">
            <Rectangle Fill="#FF5500" HorizontalAlignment="Stretch">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
