<UserControl x:Class="SoundDrought.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SoundDrought"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="48" Background="{StaticResource BarBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: app icon, history, home -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Image Source="/Assets/app.ico" Width="18" Height="18" Margin="4,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Button x:Name="BackButton" Style="{StaticResource NavButton}" Content="&#xE72B;"
                    ToolTip="{x:Static local:L.Back}" AutomationProperties.Name="{x:Static local:L.Back}" IsEnabled="False" Click="OnBack" />
            <Button x:Name="ForwardButton" Style="{StaticResource NavButton}" Content="&#xE72A;"
                    ToolTip="{x:Static local:L.Forward}" AutomationProperties.Name="{x:Static local:L.Forward}" IsEnabled="False" Click="OnForward" />
            <Button x:Name="HomeButton" Style="{StaticResource NavButton}" Content="&#xE80F;" FontSize="17"
                    ToolTip="{x:Static local:L.Home}" AutomationProperties.Name="{x:Static local:L.Home}" Click="OnHome" Margin="6,0,2,0" />
        </StackPanel>

        <!-- Center: search -->
        <Border x:Name="SearchField" Grid.Column="1" Height="34" MaxWidth="460" MinWidth="110" Margin="10,0"
                CornerRadius="17" Background="#242424" BorderBrush="#2E2E2E" BorderThickness="1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="IBeam" MouseLeftButtonDown="OnSearchFieldClick">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="{x:Static local:L.SearchPlaceholder}"
                           Foreground="#7A7A7A" FontSize="13.5" Margin="10,0,0,1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Margin="8,0,0,0"
                         TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource NavButton}" Content="&#xE711;"
                        FontSize="11" Width="26" Height="26" Visibility="Collapsed" Click="OnClearSearch" Cursor="Arrow" />
            </Grid>
        </Border>

        <!-- Right: sections, account -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
            <StackPanel x:Name="SectionButtons" Orientation="Horizontal">
                <Button x:Name="FeedButton" Style="{StaticResource NavButton}" Content="&#xE716;"
                        ToolTip="{x:Static local:L.Feed}" AutomationProperties.Name="{x:Static local:L.Feed}" Click="OnFeed" />
                <Button x:Name="LibraryButton" Style="{StaticResource NavButton}" Content="&#xE8F1;"
                        ToolTip="{x:Static local:L.Library}" AutomationProperties.Name="{x:Static local:L.Library}" Click="OnLibrary" />
                <Grid>
                    <Button x:Name="NotificationsButton" Style="{StaticResource NavButton}" Content="&#xEA8F;"
                            ToolTip="{x:Static local:L.Notifications}" AutomationProperties.Name="{x:Static local:L.Notifications}" Click="OnNotifications" />
                    <Ellipse x:Name="NotificationsDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                             IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <Grid>
                    <Button x:Name="MessagesButton" Style="{StaticResource NavButton}" Content="&#xE8BD;"
                            ToolTip="{x:Static local:L.Messages}" AutomationProperties.Name="{x:Static local:L.Messages}" Click="OnMessages" />
                    <Ellipse x:Name="MessagesDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                             IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <Button x:Name="SignInButton" Style="{StaticResource PillButton}" Content="{x:Static local:L.SignIn}"
                    Visibility="Collapsed" Click="OnSignIn" />

            <Button x:Name="AccountButton" Style="{StaticResource NavButton}" Width="40" Height="40"
                    ToolTip="{x:Static local:L.Account}" AutomationProperties.Name="{x:Static local:L.Account}" Click="OnAccount" Margin="4,0,0,0">
                <Grid Width="30" Height="30">
                    <Ellipse Fill="#2E2E2E" />
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="Avatar" Stroke="#3A3A3A" StrokeThickness="1" />
                    <Ellipse x:Name="AccountDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                             IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- Window caption -->
        <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{x:Static local:L.Minimize}" AutomationProperties.Name="{x:Static local:L.Minimize}" Click="OnMinimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="{x:Static local:L.Maximize}" AutomationProperties.Name="{x:Static local:L.Maximize}" Click="OnMaximize" />
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="{x:Static local:L.Close}" AutomationProperties.Name="{x:Static local:L.Close}" Click="OnClose" />
        </StackPanel>
    </Grid>
</UserControl>
